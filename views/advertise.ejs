<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/promo-strip') %>
<main>
  <section class="page-hero page-hero-business"><div class="container"><div class="eyebrow">FOR SCHOOLS, COLLEGES & UNIVERSITIES</div><h1>Put your institution<br>in the spotlight.</h1><p>Show people what makes your campus special. Share your facilities, admissions information, photos and video tours with people exploring education in Kenya.</p><a href="#school-form" class="button button-primary">Create your listing ↓</a></div></section>
  <section class="container section business-layout"><div class="business-copy"><div class="eyebrow">HOW IT WORKS</div><h2>Your institution.<br>Your story. Your audience.</h2><div class="steps-list"><div><b>01</b><span><strong>Submit your profile</strong><small>Tell us about your institution, location and programmes.</small></span></div><div><b>02</b><span><strong>Our team reviews it</strong><small>We check the information and contact details before publication.</small></span></div><div><b>03</b><span><strong>Choose visibility</strong><small>Request a standard listing, VIP or VVIP promotion after approval.</small></span></div><div><b>04</b><span><strong>Stay up to date</strong><small>Published owner-submitted listings are renewed every 30 days.</small></span></div></div><div class="note-strip compact"><span class="note-mark">i</span><p>Submission is not automatic verification or a paid promotion. We will contact you about review and package options.</p></div></div>
    <form class="form-card" id="school-form" action="/advertise" method="post" enctype="multipart/form-data"><div class="eyebrow">INSTITUTION SUBMISSION</div><h2>Tell us about your institution</h2><% if (typeof sent !== 'undefined' && sent) { %><div class="success-message">Your submission has been received for review.</div><% } %>
      <label>Institution name *<input name="name" required maxlength="160" placeholder="e.g. Greenfield Academy"></label>
      <div class="form-row"><label>Institution type<select name="category"><option value="school">School</option><option value="college">College / TVET</option><option value="university">University</option></select></label><label>Ownership<select name="ownership"><option value="Private">Private</option><option value="Public">Public</option><option value="Other">Other</option></select></label></div>
      <div class="form-row"><label>County<input name="county" required placeholder="e.g. Kiambu"></label><label>Town / area<input name="town" placeholder="e.g. Ruiru"></label></div>
      <label>Education levels or programmes<input name="levels" placeholder="Pre-primary, Primary, Junior, Secondary..."></label>
      <div class="form-row"><label>Accommodation<select name="accommodation"><option value="">Not specified</option><option>Day</option><option>Boarding</option><option>Day and boarding</option></select></label><label>Gender intake<select name="gender"><option value="">Not specified</option><option>Mixed</option><option>Boys</option><option>Girls</option></select></label></div>
      <label>Curriculum / programmes<input name="curriculum" placeholder="CBC, Cambridge, TVET course areas..."></label>
      <div class="form-row"><label>Indicative fee range <small>(optional)</small><input name="fees_range" maxlength="100" placeholder="e.g. KSh 30,000–50,000 per term"></label><label>Campus address <small>(optional)</small><input name="address" maxlength="250" placeholder="Street, estate or campus address"></label></div>
      <label>Short description<textarea name="description" rows="4" maxlength="2500" placeholder="Tell parents and learners about your institution..."></textarea></label>
      <div class="form-row"><label>Phone number<input name="phone" placeholder="+254..."></label><label>Contact email<input type="email" name="email" placeholder="admissions@example.ac.ke"></label></div>
      <label>Official website<input name="website" placeholder="https://..."></label>
      <label>Campus video link <small>(YouTube or Vimeo link)</small><input name="video_url" placeholder="https://..."></label>
      <label>Campus photographs <small>(JPG, PNG or WebP · up to 6 photos · 8MB each)</small><input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple></label>
      <label>Visibility package you are interested in<select name="requested_tier"><option value="none">Standard listing</option><option value="vip">VIP · Green promotion</option><option value="vvip">VVIP · Gold promotion</option></select><small>Requesting a package is not payment or approval. We will confirm pricing and payment before promotion.</small></label>
      <label class="honeypot" aria-hidden="true">Leave this field empty<input name="website_confirm" tabindex="-1" autocomplete="off"></label>
      <label class="consent-check"><input type="checkbox" required> I confirm that I am authorised to submit this information and have permission to share any uploaded images.</label>
      <button class="button button-dark full-width" type="submit">Submit institution for review <span>→</span></button><small class="form-footnote">Your information will be reviewed before publication. Promotions are labelled sponsored and run for a selected period. Do not upload identifiable student images without the required permissions.</small>
    </form></section>
</main>
<%- include('partials/footer') %>
