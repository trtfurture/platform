<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/promo-strip') %>
<main>
  <section class="profile-hero" style="background-image:linear-gradient(90deg,rgba(13,35,57,.92),rgba(13,35,57,.32)),url('<%= school.cover_path || '/images/school-hero.webp' %>')"><div class="container profile-hero-content"><div class="eyebrow light"><%= school.category === 'university' ? 'UNIVERSITY PROFILE' : school.category === 'college' ? 'COLLEGE PROFILE' : 'SCHOOL PROFILE' %></div><h1><%= school.name %></h1><p>⌖ <%= [school.town, school.county, 'Kenya'].filter(Boolean).join(', ') %></p><div class="badge-row"><% if (school.trust_status==='recognised') { %><span class="trust-badge recognised">✓ Recognised listing</span><% } else if (school.trust_status==='official') { %><span class="trust-badge official">✓ Institution confirmed</span><% } %><% if (school.active_promotion_tier==='vip') { %><span class="promo-badge vip">VIP · Sponsored</span><% } else if (school.active_promotion_tier==='vvip') { %><span class="promo-badge vvip">VVIP · Featured</span><% } %></div></div></section>
  <section class="container profile-layout"><article class="profile-main"><% if (enquirySent) { %><div class="success-message">Your enquiry has been saved. The institution can follow up using the contact details you provided.</div><% } %><div class="profile-block"><div class="eyebrow">ABOUT THE INSTITUTION</div><h2>Get to know <%= school.name %></h2><p><%= school.description || 'Institution information will be added as the profile is confirmed.' %></p><% if (school.source_note) { %><div class="verification-note"><strong>About this listing</strong><span><%= school.source_note %> Recognition is not the same as direct confirmation by the institution.</span></div><% } %></div>
    <div class="profile-block"><div class="eyebrow">AT A GLANCE</div><div class="fact-grid"><div><small>Institution type</small><strong><%= school.category %></strong></div><div><small>Ownership</small><strong><%= school.ownership || 'Not yet supplied' %></strong></div><div><small>Education levels</small><strong><%= school.levels || 'Not yet supplied' %></strong></div><div><small>Accommodation</small><strong><%= school.accommodation || 'Not specified' %></strong></div><div><small>Gender</small><strong><%= school.gender || 'Not specified' %></strong></div><div><small>Curriculum / programmes</small><strong><%= school.curriculum || 'Contact institution' %></strong></div><div><small>Location</small><strong><%= [school.town, school.county].filter(Boolean).join(', ') || 'Kenya' %></strong></div><div><small>Indicative fees</small><strong><%= school.fees_range || 'Contact institution' %></strong></div><div><small>Profile views</small><strong><%= school.views %></strong></div></div></div>
    <% if (photos && photos.length) { %><div class="profile-block"><div class="eyebrow">CAMPUS GALLERY</div><div class="profile-photo-grid"><% photos.forEach((photo, index) => { %><img class="profile-gallery-image" src="<%= photo %>" alt="Campus photograph <%= index + 1 %> for <%= school.name %>" loading="lazy"><% }) %></div></div><% } %>
    <% if (school.video_url) { %><div class="profile-block"><div class="eyebrow">CAMPUS VIDEO</div><a class="button button-outline" href="<%= school.video_url %>" target="_blank" rel="noopener">Watch campus video ↗</a></div><% } %>
    <div class="profile-block"><h2>Explore related institutions</h2><% if (related.length) { %><div class="related-list"><% related.forEach((item) => { %><a href="/school/<%= item.slug %>"><strong><%= item.name %></strong><span><%= [item.town,item.county].filter(Boolean).join(', ') %> →</span></a><% }) %></div><% } else { %><p>More institutions will appear here as the directory grows.</p><% } %></div>
  </article>
  <aside class="profile-aside"><div class="contact-card"><div class="eyebrow">CONTACT & VISIT</div><h3>Connect with the institution</h3><% if (school.phone) { %><a class="contact-line" href="tel:<%= school.phone %>">☎ <%= school.phone %></a><% } %><% if (school.email) { %><a class="contact-line" href="mailto:<%= school.email %>">✉ <%= school.email %></a><% } %><% if (school.website) { %><a class="button button-dark full-width" href="<%= school.website %>" target="_blank" rel="noopener">Visit official website ↗</a><% } %><% if (!school.phone && !school.email && !school.website) { %><p class="muted">Contact information has not yet been supplied. Check the institution's official channels.</p><% } %><div class="contact-disclaimer">Confirm fees, vacancies and admissions directly with the institution before making a decision.</div></div><div class="sidebar-ad"><span class="eyebrow">CAMPUS LIVING</span><h3>Need accommodation nearby?</h3><p>Find hostels and student rentals around Kenyan campuses.</p><a href="/campus-living">Explore campus living →</a></div><form class="form-card compact-form" action="/school/<%= school.slug %>/enquiry" method="post"><div class="eyebrow">ASK THE INSTITUTION</div><h3>Send an enquiry</h3><label>Your name *<input name="name" required maxlength="120"></label><label>Email<input type="email" name="email"></label><label>Phone / WhatsApp<input name="phone" maxlength="60"></label><label>Your message *<textarea name="message" rows="3" required minlength="10" maxlength="2000" placeholder="Ask about admissions, courses, fees or visiting..."></textarea></label><label class="consent-check"><input type="checkbox" required> I agree that my enquiry may be shared with this institution so it can respond.</label><button class="button button-dark full-width" type="submit">Send enquiry →</button><small class="form-footnote">Do not include sensitive personal information about a child.</small></form><div class="promote-card"><span class="eyebrow">ARE YOU THE SCHOOL OWNER?</span><h3>Manage this profile</h3><p>Claim your institution, confirm information and showcase your campus.</p><a class="text-link" href="/advertise">Claim or promote →</a></div></aside></section>
  <script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":school.category === 'university' ? 'CollegeOrUniversity' : school.category === 'college' ? 'EducationalOrganization' : 'School',"name":school.name,"url":`${siteUrl}/school/${school.slug}`,"description":school.description || undefined,"address":school.county ? {"@type":"PostalAddress","addressLocality":school.town || undefined,"addressRegion":school.county,"addressCountry":"KE"} : undefined,"telephone":school.phone || undefined,"email":school.email || undefined,"sameAs":school.website ? [school.website] : undefined,"image":school.cover_path ? `${siteUrl}${school.cover_path}` : `${siteUrl}/images/school-hero.webp`}).replace(/</g,'\\u003c') %></script>
</main>
<%- include('partials/footer') %>
