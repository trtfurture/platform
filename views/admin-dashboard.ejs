<%- include('partials/head') %>
<main class="admin-shell">
  <header class="admin-topbar"><a class="brand" href="/"><span class="brand-mark">S<span>.</span></span><span class="brand-copy"><strong>SCHOOLS</strong><small>ADMIN CONTROL ROOM</small></span></a><div class="admin-actions"><a href="/" target="_blank">View public site ↗</a><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline" type="submit">Sign out</button></form></div></header>
  <div class="admin-content"><div class="admin-welcome"><div><div class="eyebrow">PLATFORM OPERATIONS</div><h1>Good day, administrator.</h1><p>Review submissions, keep profiles accurate and maintain the platform.</p></div><form action="/admin/backup" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-dark" type="submit">↓ Download SQLite backup</button></form></div>
  <div class="admin-stats"><div><small>Published institutions</small><strong><%= stats.schools %></strong></div><div><small>Pending review</small><strong><%= stats.pending %></strong></div><div><small>Expired listings</small><strong><%= stats.expired %></strong></div><div><small>Pending property ads</small><strong><%= stats.properties %></strong></div><div><small>Parent enquiries</small><strong><%= stats.enquiries %></strong></div></div>
  <section class="admin-panel"><div class="admin-panel-heading"><div><div class="eyebrow">INSTITUTION DIRECTORY</div><h2>School & institution listings</h2></div><span class="admin-muted">Owner-submitted listings renew every 30 days</span></div>
    <p class="admin-muted admin-legend">Recognition is separate from paid placement: white = recognised public listing; brown = institution confirmed; green = VIP sponsored; gold = VVIP sponsored across relevant pages.</p><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Institution</th><th>Type / location</th><th>Status</th><th>Trust</th><th>Promotion</th><th>Actions</th></tr></thead><tbody>
      <% schools.forEach((school) => { %><tr><td><strong><%= school.name %></strong><small>Created <%= formatDate(school.created_at) %><% if (school.requested_tier && school.requested_tier !== 'none') { %> · Requested <%= school.requested_tier.toUpperCase() %><% } %></small></td><td><%= school.category %><small><%= [school.town,school.county].filter(Boolean).join(', ') %></small></td><td><span class="status-pill <%= school.status %>"><%= school.status %></span><% if (school.expires_at) { %><small>Until <%= formatDate(school.expires_at) %></small><% } %></td><td><form class="inline-admin-form" method="post" action="/admin/schools/<%= school.id %>/trust"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="trust_status"><option value="unverified" <%= school.trust_status==='unverified'?'selected':'' %>>Unverified</option><option value="recognised" <%= school.trust_status==='recognised'?'selected':'' %>>Recognised · white</option><option value="official" <%= school.trust_status==='official'?'selected':'' %>>Institution confirmed · brown</option></select><button class="mini-button" type="submit">Save</button></form></td><td><form class="inline-admin-form" method="post" action="/admin/schools/<%= school.id %>/promotion"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="promotion_tier"><option value="none" <%= school.promotion_tier==='none'?'selected':'' %>>None</option><option value="vip" <%= school.promotion_tier==='vip'?'selected':'' %>>VIP · Green</option><option value="vvip" <%= school.promotion_tier==='vvip'?'selected':'' %>>VVIP · Gold</option></select><select name="duration_days" aria-label="Promotion duration"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option></select><button class="mini-button" type="submit">Save</button></form><% if (school.promotion_expires_at) { %><small>Boost ends <%= formatDate(school.promotion_expires_at) %></small><% } %></td><td><div class="admin-row-actions"><a class="mini-button" href="/school/<%= school.slug %>" target="_blank">View</a><% if (school.status==='pending') { %><form method="post" action="/admin/schools/<%= school.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-button mini-primary" type="submit">Approve · 30 days</button></form><% } else { %><form method="post" action="/admin/schools/<%= school.id %>/renew"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-button" type="submit">Renew 30 days</button></form><% } %></div></td></tr><% }) %>
    </tbody></table></div>
  </section>
  <section class="admin-panel"><div class="admin-panel-heading"><div><div class="eyebrow">CAMPUS MARKETPLACE</div><h2>Accommodation submissions</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Listing</th><th>Location</th><th>Contact</th><th>Status</th><th>Actions</th></tr></thead><tbody><% properties.forEach((item) => { %><tr><td><strong><%= item.title %></strong><small><%= item.property_type %> · <%= item.institution %></small></td><td><%= [item.town,item.county].filter(Boolean).join(', ') %><small><%= item.price %></small></td><td><%= item.contact %></td><td><span class="status-pill <%= item.status %>"><%= item.status %></span></td><td><div class="admin-row-actions"><% if (item.status==='pending') { %><form method="post" action="/admin/properties/<%= item.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-button mini-primary" type="submit">Approve</button></form><% } %><form method="post" action="/admin/properties/<%= item.id %>/hide"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-button" type="submit">Hide</button></form></div></td></tr><% }) %></tbody></table></div></section>
  <section class="admin-panel"><div class="admin-panel-heading"><div><div class="eyebrow">PARENT & LEARNER CONTACT</div><h2>Recent institution enquiries</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Institution</th><th>Enquirer</th><th>Contact</th><th>Message</th><th>Received</th></tr></thead><tbody><% enquiries.forEach((item) => { %><tr><td><strong><%= item.school_name || 'Institution' %></strong></td><td><%= item.name %></td><td><%= item.phone %><small><%= item.email %></small></td><td><%= item.message %></td><td><%= formatDate(item.created_at) %></td></tr><% }) %></tbody></table></div></section>
  <section class="admin-panel"><div class="admin-panel-heading"><div><div class="eyebrow">DIGITAL PORTAL REQUESTS</div><h2>School website & portal enquiries</h2></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Institution</th><th>Contact person</th><th>Phone</th><th>Email</th><th>Requirements</th><th>Received</th></tr></thead><tbody><% portalEnquiries.forEach((item) => { %><tr><td><strong><%= item.institution %></strong></td><td><%= item.contact_name %></td><td><%= item.phone %></td><td><%= item.email %></td><td><%= item.message %></td><td><%= formatDate(item.created_at) %></td></tr><% }) %></tbody></table></div></section>
  <section class="admin-panel" id="errors"><div class="admin-panel-heading"><div><div class="eyebrow">SYSTEM HEALTH</div><h2>Recent admin errors</h2><p class="admin-muted">Application errors are recorded here for diagnosis.</p></div><form action="/admin/errors/clear" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mini-button" type="submit">Clear log</button></form></div><% if (errors.length) { %><div class="error-log-list"><% errors.forEach((item) => { %><details><summary><span class="error-dot"></span><strong><%= item.message %></strong><small><%= formatDate(item.created_at) %> · <%= item.route %></small></summary><pre><%= item.stack %></pre></details><% }) %></div><% } else { %><p class="empty-inline">No errors have been recorded. That's a good sign.</p><% } %></section>
  <div class="admin-footnote">Keep an off-platform copy of important backups. A backup stored on the same disk does not protect against loss of that disk.</div>
  </div>
</main>
</body></html>
